"src/main.jsx": r'''import React, { useMemo, useState } from "react";
import { createRoot } from "react-dom/client";
import {
  Activity, ArrowDownLeft, ArrowUpRight, Bot, CalendarClock, CheckCheck,
  ChevronDown, CircleHelp, Command, Inbox, LayoutDashboard, MessageCircle,
  MoreHorizontal, Plus, Search, Send, Settings2, ShieldCheck, Sparkles,
  Users, Workflow, Zap
} from "lucide-react";
import "./styles.css";

const initialConversations = [
  { id: 1, name: "Olivia Martin", company: "Northstar Studio", channel: "WhatsApp", initials: "OM", color: "lavender", time: "2m", status: "Needs reply", unread: 2, message: "Hi! Could you send me the pricing details for the monthly plan?", email: "olivia@northstar.example", value: "€1,200" },
  { id: 2, name: "Ethan Wilson", company: "Wilson & Co.", channel: "Instagram", initials: "EW", color: "peach", time: "18m", status: "Open", unread: 0, message: "Thanks, that works. Can we book a quick call for Thursday?", email: "ethan@wilson.example", value: "€850" },
  { id: 3, name: "Sophia Chen", company: "Bloom & Co.", channel: "Email", initials: "SC", color: "mint", time: "42m", status: "Waiting", unread: 0, message: "I sent the product list over. Let me know if you need anything else.", email: "sophia@bloom.example", value: "€2,400" },
  { id: 4, name: "Noah Patel", company: "Patel Fitness", channel: "WhatsApp", initials: "NP", color: "blue", time: "1h", status: "Open", unread: 0, message: "Do you support automated appointment reminders?", email: "noah@patelfitness.example", value: "€640" },
  { id: 5, name: "Ava Murphy", company: "Ava Interiors", channel: "Web chat", initials: "AM", color: "rose", time: "3h", status: "Resolved", unread: 0, message: "Perfect, thank you for your help!", email: "ava@interiors.example", value: "€1,750" },
];

const navItems = [
  { label: "Overview", icon: LayoutDashboard },
  { label: "Unified inbox", icon: Inbox, badge: "4" },
  { label: "Contacts", icon: Users },
  { label: "Automations", icon: Workflow },
  { label: "Analytics", icon: Activity },
];

function App() {
  const [activeNav, setActiveNav] = useState("Unified inbox");
  const [conversations, setConversations] = useState(initialConversations);
  const [selectedId, setSelectedId] = useState(1);
  const [query, setQuery] = useState("");
  const [reply, setReply] = useState("");
  const [notice, setNotice] = useState("");
  const [showAutomation, setShowAutomation] = useState(false);
  const [filter, setFilter] = useState("All");

  const selected = conversations.find((c) => c.id === selectedId) || conversations[0];
  const filtered = useMemo(() => conversations.filter((c) => {
    const matchesQuery = `${c.name} ${c.company} ${c.message} ${c.channel}`.toLowerCase().includes(query.toLowerCase());
    const matchesFilter = filter === "All" || c.status === filter;
    return matchesQuery && matchesFilter;
  }), [conversations, query, filter]);

  function updateSelectedStatus(status) {
    setConversations((prev) => prev.map((c) => c.id === selectedId ? { ...c, status } : c));
    setNotice(`Conversation marked ${status.toLowerCase()}.`);
    setTimeout(() => setNotice(""), 2400);
  }

  function generateDraft() {
    const draft = `Hi ${selected.name.split(" ")[0]}, thanks for reaching out! I'd be happy to help with that. I'll share the relevant details shortly. Is there anything specific you'd like me to include?`;
    setReply(draft);
    setNotice("Sample AI-assisted draft added. No AI API is connected.");
    setTimeout(() => setNotice(""), 3200);
  }

  function sendReply() {
    if (!reply.trim()) return;
    setConversations((prev) => prev.map((c) => c.id === selectedId ? { ...c, message: `You: ${reply}`, time: "now", status: "Waiting", unread: 0 } : c));
    setReply("");
    setNotice("Demo reply added locally. It was not sent to a real customer.");
    setTimeout(() => setNotice(""), 3200);
  }

  return (
    <div className="app-shell">
      <aside className="sidebar">
        <div className="brand">
          <div className="brand-mark"><Command size={20} strokeWidth={2.5}/></div>
          <div><strong>automora</strong><span>AI WORKSPACE</span></div>
        </div>
        <button className="workspace-switch"><span className="workspace-dot">N</span><span className="workspace-copy"><b>Northstar workspace</b><small>Free prototype</small></span><ChevronDown size={16}/></button>
        <div className="nav-caption">WORKSPACE</div>
        <nav>
          {navItems.map(({ label, icon: Icon, badge }) => (
            <button key={label} onClick={() => { setActiveNav(label); setNotice(label === "Unified inbox" ? "" : `${label} view is a prototype preview.`); }} className={`nav-item ${activeNav === label ? "active" : ""}`}>
              <Icon size={18}/><span>{label}</span>{badge && <em>{badge}</em>}
            </button>
          ))}
        </nav>
        <div className="nav-caption tools-caption">TOOLS</div>
        <button className={`nav-item ${showAutomation ? "active" : ""}`} onClick={() => setShowAutomation(!showAutomation)}><Zap size={18}/><span>Follow-up flow</span></button>
        {showAutomation && <div className="automation-mini"><b>New lead follow-up</b><span>When a lead is waiting 24h</span><span>→ Create a reminder</span><span className="flow-state"><i/> Draft workflow</span></div>}
        <div className="sidebar-bottom">
          <div className="help-card"><div className="help-icon"><CircleHelp size={17}/></div><b>Need a hand?</b><p>Explore how Automora can fit your workflow.</p><button onClick={() => setNotice("Help centre is not connected in this prototype.")}>Visit help centre <ArrowUpRight size={13}/></button></div>
          <button className="nav-item"><Settings2 size={18}/><span>Settings</span></button>
          <div className="profile-row"><div className="avatar profile-avatar">NA</div><div className="profile-copy"><b>Naushad Ali</b><small>Workspace admin</small></div><MoreHorizontal size={18}/></div>
        </div>
      </aside>

      <main className="main-area">
        <header className="topbar">
          <div className="breadcrumbs">Workspace <span>/</span> <b>{activeNav}</b></div>
          <div className="top-actions"><div className="system-status"><i/> All systems normal</div><button className="icon-button" aria-label="Notifications"><Activity size={17}/></button><div className="avatar top-avatar">NA</div></div>
        </header>

        <div className="page-content">
          <div className="page-heading">
            <div><div className="eyebrow"><span className="eyebrow-dot"/> CUSTOMER OPERATIONS</div><h1>{activeNav}</h1><p>Every customer conversation, together in one calm workspace.</p></div>
            <button className="primary-button" onClick={() => setNotice("Connect a messaging provider to start a real conversation.")}><Plus size={17}/> New conversation</button>
          </div>

          <section className="metrics">
            <Metric icon={Inbox} label="Open conversations" value="24" trend="+12.5%" note="vs. last week" />
            <Metric icon={Users} label="Active contacts" value="186" trend="+8.2%" note="vs. last week" />
            <Metric icon={CalendarClock} label="Avg. response time" value="4m 32s" trend="-18.4%" note="vs. last week" />
            <Metric icon={CheckCheck} label="Resolved today" value="38" trend="+16.8%" note="vs. last week" />
          </section>

          <section className="inbox-layout">
            <div className="conversation-list">
              <div className="list-header"><div><h2>Conversations</h2><span className="subtle">Stay on top of every message</span></div><button className="small-icon"><MoreHorizontal size={18}/></button></div>
              <div className="search-box"><Search size={16}/><input value={query} onChange={(e) => setQuery(e.target.value)} placeholder="Search conversations..." /></div>
              <div className="filter-tabs">{["All", "Needs reply", "Open", "Waiting"].map((f) => <button key={f} className={filter === f ? "selected" : ""} onClick={() => setFilter(f)}>{f}</button>)}</div>
              <div className="conversation-items">
                {filtered.map((c) => <button key={c.id} className={`conversation ${selectedId === c.id ? "chosen" : ""}`} onClick={() => { setSelectedId(c.id); setReply(""); }}>
                  <div className={`avatar ${c.color}`}>{c.initials}</div>
                  <div className="conversation-main"><div className="conversation-top"><b>{c.name}</b><time>{c.time}</time></div><div className="company">{c.company}</div><p>{c.message}</p><div className="conversation-meta"><span className={`channel ${c.channel.toLowerCase().replace(" ", "-")}`}><i/>{c.channel}</span><span className={`status status-${c.status.toLowerCase().replace(" ", "-")}`}>{c.status}</span></div></div>
                  {c.unread > 0 && <span className="unread">{c.unread}</span>}
                </button>)}
                {filtered.length === 0 && <div className="empty-state">No conversations match your search.</div>}
              </div>
              <div className="list-footer"><span>Showing {filtered.length} of {conversations.length} sample conversations</span><span className="live-dot"/> Demo data</div>
            </div>

            <div className="thread-panel">
              <div className="thread-header"><div className={`avatar ${selected.color}`}>{selected.initials}</div><div className="thread-person"><h2>{selected.name}</h2><span>{selected.company} <span className="dot-separator">·</span> {selected.channel}</span></div><div className="thread-actions"><button className="secondary-button" onClick={() => updateSelectedStatus("Resolved")}><CheckCheck size={15}/> Resolve</button><button className="small-icon"><MoreHorizontal size={18}/></button></div></div>
              <div className="thread-context"><span><ShieldCheck size={14}/> Customer conversation</span><span>Today, 10:42 AM</span></div>
              <div className="message-stream">
                <div className="date-divider"><span>Today</span></div>
                <div className="message-row"><div className={`avatar tiny ${selected.color}`}>{selected.initials}</div><div className="message-content"><div className="message-byline"><b>{selected.name}</b><time>10:42 AM</time></div><div className="bubble incoming">{selected.message}</div><span className="message-source"><MessageCircle size={12}/> Received via {selected.channel}</span></div></div>
                <div className="ai-suggestion"><div className="ai-label"><Sparkles size={14}/> AUTOMORA AI <span>· Suggested next step</span></div><p>Respond promptly, answer the customer's question clearly, and offer a useful next step. Review any AI-generated text before sending.</p><button onClick={generateDraft}><Sparkles size={14}/> Draft a reply <ArrowUpRight size={13}/></button></div>
              </div>
              <div className="composer">
                <div className="composer-tools"><span>Reply to {selected.name.split(" ")[0]}</span><span className="demo-label">DEMO MODE</span></div>
                <textarea value={reply} onChange={(e) => setReply(e.target.value)} placeholder="Write a thoughtful reply..." rows="3"/>
                <div className="composer-footer"><span><Bot size={15}/> AI drafts are suggestions — review before sending</span><button className="primary-button send-button" onClick={sendReply} disabled={!reply.trim()}><Send size={14}/> Add reply</button></div>
              </div>
            </div>

            <aside className="contact-panel">
              <div className="contact-head"><h3>Customer profile</h3><button className="small-icon"><MoreHorizontal size={18}/></button></div>
              <div className="contact-identity"><div className={`avatar large ${selected.color}`}>{selected.initials}</div><h2>{selected.name}</h2><p>{selected.company}</p><span className="customer-tag">Potential customer</span></div>
              <div className="contact-actions"><button onClick={() => setNotice("Email integration is not connected.")}><MessageCircle size={15}/> Message</button><button onClick={() => setNotice("Contact editing is not available in this demo.")}><Settings2 size={15}/> Edit</button></div>
              <div className="profile-section"><h4>CONTACT DETAILS</h4><div className="detail-row"><span>Email</span><b>{selected.email}</b></div><div className="detail-row"><span>Preferred channel</span><b>{selected.channel}</b></div><div className="detail-row"><span>Customer value</span><b>{selected.value}</b></div></div>
              <div className="profile-section"><h4>CONVERSATION</h4><div className="detail-row"><span>Status</span><b className={`status status-${selected.status.toLowerCase().replace(" ", "-")}`}>{selected.status}</b></div><div className="detail-row"><span>Assigned to</span><b className="assigned"><span className="avatar micro">NA</span> Naushad Ali</b></div><div className="detail-row"><span>Last activity</span><b>{selected.time === "now" ? "Just now" : selected.time + " ago"}</b></div></div>
              <div className="timeline-card"><div className="timeline-icon"><Zap size={16}/></div><div><b>Follow-up automation</b><p>Remind your team if this conversation needs attention.</p><button onClick={() => setShowAutomation(!showAutomation)}> {showAutomation ? "Hide workflow" : "View workflow"} <ArrowUpRight size={12}/></button></div></div>
            </aside>
          </section>
          <footer className="page-footer"><span>Automora AI <span>·</span> Hackathon prototype</span><span><i/> Sample data only · No messages are sent externally</span></footer>
        </div>
      </main>
      {notice && <div className="toast"><span className="toast-check">✓</span>{notice}<button onClick={() => setNotice("")}>×</button></div>}
    </div>
  );
}

function Metric({ icon: Icon, label, value, trend, note }) {
  return <div className="metric-card"><div className="metric-top"><span>{label}</span><div className="metric-icon"><Icon size={17}/></div></div><div className="metric-value">{value}</div><div className="metric-bottom"><span className={trend.startsWith("-") ? "trend good" : "trend"}>{trend}</span><span>{note}</span></div></div>;
}

createRoot(document.getElementById("root")).render(<App />);
''',
